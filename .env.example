# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=

# Optional overrides
# GEMINI_MODEL=gemini-3.5-flash
# PAYOUT_PROVIDER=simulated          # the only built-in provider: a clearly labelled sandbox, no real money
# SANDBOX_BALANCE_PAISE=2000000000   # simulated wallet balance (Rs 2 crore); payouts beyond it fail
# BUYER_NAME=Bluebird Retail Pvt Ltd
# BUYER_GSTIN=29AABCB5521M1ZJ        # invoices billed to any other GSTIN are held
# DB_PATH=backend/invoiceguard.db
# PER_PAYMENT_LIMIT_PAISE=50000000   # Rs 5,00,000
# DAILY_LIMIT_PAISE=150000000        # Rs 15,00,000
# DEMO_COOLDOWN_SECONDS=0            # rate-limit the demo reset endpoint (0 = unlimited)
